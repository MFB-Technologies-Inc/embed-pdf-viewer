<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Phase 0 generator spike (docs/superpowers/plans/2026-11-20-dotnet-parity.md).
    Throwaway: compiles the uniffi-bindgen-cs output for epdf-viewer-host into
    this test assembly and drives it from xUnit. The generated C# is a build
    output under target/csharp-spike/generated and is never committed.
  -->
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../../'))</RepoRoot>
    <SpikeGeneratedDir Condition="'$(SpikeGeneratedDir)' == ''">$(RepoRoot)target/csharp-spike/generated/</SpikeGeneratedDir>
    <SpikeNativeDir Condition="'$(SpikeNativeDir)' == ''">$(RepoRoot)target/release/</SpikeNativeDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1"/>
    <PackageReference Include="xunit" Version="2.9.3"/>
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4"/>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="$(SpikeGeneratedDir)*.cs" Link="Generated/%(Filename)%(Extension)"/>
    <None Include="$(SpikeNativeDir)libepdf_viewer_host.so" Link="libepdf_viewer_host.so" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(SpikeNativeDir)libepdf_viewer_host.so')"/>
  </ItemGroup>
</Project>

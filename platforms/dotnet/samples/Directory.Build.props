<Project>
  <!--
    The samples build only against packed packages from a feed, the way an
    app outside this repository does, so they take none of the repository's
    build settings (platforms/dotnet/Directory.Build.props). They set the
    same ones here instead. platforms/dotnet/dotnet-consumer.sh copies this
    file with the sample.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>

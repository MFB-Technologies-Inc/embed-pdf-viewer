<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Tests for EmbedPDF.Models, the port of the Swift EmbedPDFModelsTests.
    Each test runs on a single-threaded SynchronizationContext and fails on
    any PropertyChanged raised off it (plan Review Focus 3). The viewer host
    is copied from EpdfViewerNativeDir, as in EmbedPDF.Viewer.Tests.
  -->
  <PropertyGroup>
    <!--
      The packages target net10.0, and .NET 11 apps load them too, so the
      tests run on both. Directory.Build.props sets TargetFramework, which
      would otherwise win over TargetFrameworks.
    -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../'))</RepoRoot>
    <EpdfViewerNativeDir Condition="'$(EpdfViewerNativeDir)' == ''">$(RepoRoot)target/release/</EpdfViewerNativeDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1"/>
    <PackageReference Include="xunit" Version="2.9.3"/>
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1"/>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../EmbedPDF.Models/EmbedPDF.Models.csproj"/>
    <None Include="$(EpdfViewerNativeDir)libepdf_viewer_host.so" Link="libepdf_viewer_host.so" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(EpdfViewerNativeDir)libepdf_viewer_host.so')"/>
    <None Include="$(EpdfViewerNativeDir)libepdf_viewer_host.dylib" Link="libepdf_viewer_host.dylib" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(EpdfViewerNativeDir)libepdf_viewer_host.dylib')"/>
    <None Include="$(EpdfViewerNativeDir)epdf_viewer_host.dll" Link="epdf_viewer_host.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(EpdfViewerNativeDir)epdf_viewer_host.dll')"/>
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Document JavaScript for the EmbedPDF viewer on Jint, a managed
    interpreter (docs/superpowers/plans/2026-11-20-dotnet-parity.md, D5).
    A separate package so the EmbedPDF package carries no interpreter: Jint
    builds clean under the trim and AOT analyzers here, but a NativeAOT
    publish reports IL2026, IL2104 and IL3053 from its CLR interop paths,
    which this engine never enables (plan 03b, "Decisions").
    Jint 4.18.0 is BSD-2-Clause; its dependency Acornima 1.9.1 is BSD-3-Clause.
  -->
  <PropertyGroup>
    <AssemblyName>EmbedPDF.Scripting.Jint</AssemblyName>
    <RootNamespace>EmbedPDF.Scripting.Jint</RootNamespace>
    <PackageId>EmbedPDF.Scripting.Jint</PackageId>
    <Version>0.0.0-local</Version>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Description>Runs EmbedPDF document JavaScript in Jint, with time, memory and call depth limits and no access to .NET types.</Description>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="EmbedPDF.Viewer.Tests" />
    <ProjectReference Include="../EmbedPDF.Viewer/EmbedPDF.Viewer.csproj" />
    <PackageReference Include="Jint" Version="4.18.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>

  {"name":"a-malformed-entry-stores-nothing-and-says-which-entry-it-is","covers":"A PEM header, a truncated entry, two objects in one entry and an empty one are each refused InvalidArg naming the entry, and the good entries beside them are not stored; a list that is not of byte arrays is InvalidArg too. Nothing is stored and nothing published.","fixture":"packages/engine/main/test/fixtures/unsigned_sigfield.pdf","open":{"scope":["*"]},"steps":[{"call":"addValidationInfo","input":{"certificates":["300f040d63657274696669636174652061","2d2d2d2d2d424547494e2043455254494649434154452d2d2d2d2d"],"crls":["3009040763726c206f6e65"]},"outcome":{"reject":"InvalidArg","field":"certificates[1]"},"events":[]},{"call":"addValidationInfo","input":{"certificates":["300f040d63657274696669636174652061"],"crls":["3009040763726c206f6e"]},"outcome":{"reject":"InvalidArg","field":"crls[0]"},"events":[]},{"call":"addValidationInfo","input":{"ocspResponses":["300f040d6f63737020726573706f6e7365300f040d6f63737020726573706f6e7365"]},"outcome":{"reject":"InvalidArg","field":"ocspResponses[0]"},"events":[]},{"call":"addValidationInfo","input":{"ocspResponses":[""]},"outcome":{"reject":"InvalidArg","field":"ocspResponses[0]"},"events":[]},{"call":"addValidationInfo","input":"notBytes","outcome":{"reject":"InvalidArg","field":"certificates"},"events":[]},{"call":"getValidationInfo","outcome":{"resolve":{"certificates":[],"ocspResponses":[],"crls":[]}},"events":[]}]},
  {"name":"no-undo-takes-it-back-and-the-undo-of-an-earlier-change-leaves-it","covers":"After a change that writes the catalog (an outline item here, an attachment upstream), the store is written and is not undoable: its undo is UndoUnavailable. The undo of the earlier change still runs and leaves the store.","fixture":"packages/engine/main/test/fixtures/unsigned_sigfield.pdf","open":{"scope":["*"]},"steps":[{"call":"apply","change":{"ops":[{"type":"outline.create","parent":null,"data":{"title":"Notes"}}]},"opId":"notes","outcome":{"resolve":{"items":["outline.create"],"undoable":true}},"events":[]},{"call":"addValidationInfo","input":{"certificates":["300f040d63657274696669636174652061"]},"opId":"stored","outcome":{"resolve":{"added":{"certificates":1,"ocspResponses":0,"crls":0},"undoable":false,"affectedPages":[],"opId":"stored"}},"events":[{"type":"signatures.validationInfoAdded","added":{"certificates":1,"ocspResponses":0,"crls":0},"opId":"stored"}]},{"call":"apply","change":{"undoOf":"stored"},"opId":"undo-stored","outcome":{"reject":"UndoUnavailable"},"events":[]},{"call":"apply","change":{"undoOf":"notes"},"opId":"undo-notes","outcome":{"resolve":{"items":["outline.delete"],"undoable":true}},"events":[]},{"call":"getValidationInfo","outcome":{"resolve":{"certificates":["9ddee043bc433a27da141bc0c8c135748af9f4b1acc1c52bf7c3f5e8989b0482"],"ocspResponses":[],"crls":[]}},"events":[]}]},

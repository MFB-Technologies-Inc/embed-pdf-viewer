  {"name":"a-document-timestamp-needs-no-field-the-engine-makes-one","covers":"prepare({kind:\"timestamp\"}) answers Timestamp1; the live document gets the field only when the signing completes, and none when it is cancelled. The completed timestamp covers its whole revision, the field has one widget of no size on the first page, print and locked; the next gets Timestamp2 and the first stays permitted, its window explained by signature-field-added. Every prepared notice names the field. Reopened, the file has three revisions.","fixture":"packages/engine/main/test/fixtures/unsigned_sigfield.pdf","open":{"scope":["*"]},"steps":[{"call":"listFields","outcome":{"resolve":{"fields":["group.total text","sig signature"]}},"events":[]},{"call":"prepare","input":{"kind":"timestamp"},"outcome":{"resolve":{"subFilter":"ETSI.RFC3161","field":{"kind":"fqn","name":"Timestamp1"}}},"events":[{"type":"signatures.prepared","field":{"kind":"fqn","name":"Timestamp1"}}]},{"call":"listFields","outcome":{"resolve":{"fields":["group.total text","sig signature"]}},"events":[]},{"call":"cancel","outcome":{"resolve":{"status":"cancelled"}},"events":[]},{"call":"listFields","outcome":{"resolve":{"fields":["group.total text","sig signature"]}},"events":[]},{"call":"prepare","input":{"kind":"timestamp"},"outcome":{"resolve":{"subFilter":"ETSI.RFC3161","field":{"kind":"fqn","name":"Timestamp1"}}},"events":[{"type":"signatures.prepared","field":{"kind":"fqn","name":"Timestamp1"}}]},{"call":"complete","cms":"3006020101020102","outcome":{"resolve":{"status":"completed","kind":"timestamp","fieldName":"Timestamp1","coverage":"whole-revision","revisionIndex":1}},"events":[]},{"call":"listSignatures","outcome":{"resolve":{"revisions":2,"enforced":null,"signatures":["sig signature unsigned","Timestamp1 timestamp whole-revision"]}},"events":[]},{"call":"listFields","widgetOf":"Timestamp1","outcome":{"resolve":{"fields":["group.total text","sig signature","Timestamp1 signature"],"widget":{"onFirstPage":true,"width":0,"height":0,"print":true,"locked":true,"hidden":false}}},"events":[]},{"call":"prepare","input":{"kind":"timestamp"},"outcome":{"resolve":{"subFilter":"ETSI.RFC3161","field":{"kind":"fqn","name":"Timestamp2"}}},"events":[{"type":"signatures.prepared","field":{"kind":"fqn","name":"Timestamp2"}}]},{"call":"complete","cms":"3006020101020102","outcome":{"resolve":{"status":"completed","kind":"timestamp","fieldName":"Timestamp2","coverage":"whole-revision","revisionIndex":2}},"events":[]},{"call":"analyze","input":{"since":{"signatureIndex":1},"detail":"full"},"outcome":{"resolve":{"verdict":"permitted","current":"permitted","policyVersion":6,"steps":1,"refused":[],"rules":["catalog-housekeeping","signature-added","signature-field-added","trailer"]}},"events":[]},{"call":"reopen","outcome":{"resolve":{"prefixKept":true}},"events":[]},{"call":"listSignatures","outcome":{"resolve":{"revisions":3,"enforced":null,"signatures":["sig signature unsigned","Timestamp1 timestamp whole-revision","Timestamp2 timestamp whole-revision"]}},"events":[]}]},
